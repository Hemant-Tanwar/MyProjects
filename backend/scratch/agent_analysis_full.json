            },
            {
              "h": 3,
              "w": 4,
              "x": 0,
              "y": 1,
              "id": "analytics-kpi-cycle_time_po_to_gr",
              "type": "single-kpi",
              "title": "Cycle Time: PO Creation to GR",
              "width": 4,
              "height": 3,
              "layout": {
                "h": 3,
                "w": 4,
                "x": 0,
                "y": 1,
                "width": 4,
                "height": 3
              },
              "formula": {
                "name": "Cycle Time: PO Creation to GR",
                "text": "AVG(CALC_THROUGHPUT(FIRST_OCCURRENCE['Create Purchase Order Item'] TO FIRST_OCCURRENCE['Record Goods Receipt'], REMAP_TIMESTAMPS(\"P2P_EVENT_LOG\".\"EVENT_TIME\", DAYS)))"
              },
              "version": 1,
              "position": {
                "h": 3,
                "w": 4,
                "x": 0,
                "y": 1,
                "width": 4,
                "height": 3
              }
            },
            {
              "h": 3,
              "w": 4,
              "x": 4,
              "y": 1,
              "id": "analytics-kpi-invoice_processing_time",
              "type": "single-kpi",
              "title": "Invoice Processing Time",
              "width": 4,
              "height": 3,
              "layout": {
                "h": 3,
                "w": 4,
                "x": 4,
                "y": 1,
                "width": 4,
                "height": 3
              },
              "formula": {
                "name": "Invoice Processing Time",
                "text": "AVG(CALC_THROUGHPUT(FIRST_OCCURRENCE['First Invoice Created'] TO FIRST_OCCURRENCE['Clear Invoice'], REMAP_TIMESTAMPS(\"P2P_EVENT_LOG\".\"EVENT_TIME\", DAYS)))"
              },
              "version": 1,
              "position": {
                "h": 3,
                "w": 4,
                "x": 4,
                "y": 1,
                "width": 4,
                "height": 3
              }
            },
            {
              "h": 3,
              "w": 4,
              "x": 8,
              "y": 1,
              "id": "analytics-kpi-po_approval_lead_time",
              "type": "single-kpi",
              "title": "PO Approval Lead Time",
              "width": 4,
              "height": 3,
              "layout": {
                "h": 3,
                "w": 4,
                "x": 8,
                "y": 1,
                "width": 4,
                "height": 3
              },
              "formula": {
                "name": "PO Approval Lead Time",
                "text": "AVG(CALC_THROUGHPUT(FIRST_OCCURRENCE['Create Purchase Order Item'] TO FIRST_OCCURRENCE['PO Approval Step'], REMAP_TIMESTAMPS(\"P2P_EVENT_LOG\".\"EVENT_TIME\", DAYS)))"
              },
              "version": 1,
              "position": {
                "h": 3,
                "w": 4,
                "x": 8,
                "y": 1,
                "width": 4,
                "height": 3
              }
            },
            {
              "h": 3,
              "w": 4,
              "x": 0,
              "y": 4,
              "id": "analytics-kpi-payment_block_rate",
              "type": "single-kpi",
              "title": "Payment Block Rate",
              "width": 4,
              "height": 3,
              "layout": {
                "h": 3,
                "w": 4,
                "x": 0,
                "y": 4,
                "width": 4,
                "height": 3
              },
              "formula": {
                "name": "Payment Block Rate",
                "text": "COUNT_TABLE(P2P_CASES) FILTER (FILTER_ACTIVITY('Payment Block')) / COUNT_TABLE(P2P_CASES)"
              },
              "version": 1,
              "position": {
                "h": 3,
                "w": 4,
                "x": 0,
                "y": 4,
                "width": 4,
                "height": 3
              }
            },
            {
              "h": 3,
              "w": 4,
              "x": 4,
              "y": 4,
              "id": "analytics-kpi-AUTOMATION_RATE",
              "type": "single-kpi",
              "title": "Automation Rate (Touchless PO)",
              "width": 4,
              "height": 3,
              "layout": {
                "h": 3,
                "w": 4,
                "x": 4,
                "y": 4,
                "width": 4,
                "height": 3
              },
              "formula": {
                "name": "Automation Rate (Touchless PO)",
                "text": "COUNT(CASE WHEN PU_COUNT(P2P_CASES, P2P_EVENT_LOG.ACTIVITY, P2P_EVENT_LOG.USER_NAME = 'SYSTEM') = PU_COUNT(P2P_CASES, P2P_EVENT_LOG.ACTIVITY) THEN P2P_CASES.CASE_ID END) / COUNT(P2P_CASES.CASE_ID) * 100.0"
              },
              "version": 1,
              "position": {
                "h": 3,
                "w": 4,
                "x": 4,
                "y": 4,
                "width": 4,
                "height": 3
              }
            },
            {
              "h": 3,
              "w": 4,
              "x": 8,
              "y": 4,
              "id": "analytics-kpi-CASE_COUNT",
              "type": "single-kpi",
              "title": "Number of PO Cases",
              "width": 4,
              "height": 3,
              "layout": {
                "h": 3,
                "w": 4,
                "x": 8,
                "y": 4,
                "width": 4,
                "height": 3
              },
              "formula": {
                "name": "Number of PO Cases",
                "text": "COUNT(P2P_CASES.CASE_ID)"
              },
              "version": 1,
              "position": {
                "h": 3,
                "w": 4,
                "x": 8,
                "y": 4,
                "width": 4,
                "height": 3
              }
