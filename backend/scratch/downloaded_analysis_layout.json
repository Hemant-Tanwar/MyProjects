          "components": [
            {
              "h": 1,
              "w": 4,
              "x": 0,
              "y": 0,
              "id": "analytics-filter-HIGH_VALUE_PO",
              "type": "dropdown",
              "title": "High Value Po",
              "width": 4,
              "filter": {
                "name": "High Value Po",
                "text": "FILTER P2P_CASES.PO_AMOUNT > 10000;"
              },
              "height": 1,
              "layout": {
                "h": 1,
                "w": 4,
                "x": 0,
                "y": 0,
                "width": 4,
