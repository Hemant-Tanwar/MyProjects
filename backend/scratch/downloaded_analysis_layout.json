              }
            },
            {
              "h": 1,
              "w": 4,
              "x": 8,
              "y": 0,
              "id": "analytics-filter-SKIP_GR",
              "type": "dropdown",
              "title": "Skip Gr",
              "width": 4,
              "filter": {
                "name": "Skip Gr",
                "text": "FILTER NOT PROCESS OCCURRENCE['Receive Goods'];"
              },
              "height": 1,
              "layout": {
                "h": 1,
                "w": 4,
                "x": 8,
                "y": 0,
                "width": 4,
                "height": 1
              },
              "position": {
                "h": 1,
                "w": 4,
                "x": 8,
                "y": 0,
                "width": 4,
                "height": 1
              }
            },
            {
              "h": 3,
              "w": 4,
              "x": 0,
              "y": 1,
              "id": "analytics-kpi-THROUGHPUT_TIME_PO_TO_GR",
              "type": "single-kpi",
              "title": "PO to Goods Receipt Throughput",
              "width": 4,
              "height": 3,
              "layout": {
                "h": 3,
                "w": 4,
                "x": 0,
                "y": 1,
                "width": 4,
                "height": 3
              },
              "formula": {
                "name": "PO to Goods Receipt Throughput",
                "text": "AVG(CALC_THROUGHPUT(FIRST_OCCURRENCE['Create Purchase Order Item'] TO LAST_OCCURRENCE['Receive Goods'], EVENTTIME('_cel_event_log')))"
              },
              "version": 1,
              "position": {
                "h": 3,
                "w": 4,
                "x": 0,
                "y": 1,
                "width": 4,
                "height": 3
              }
            },
            {
              "h": 3,
              "w": 4,
              "x": 4,
              "y": 1,
              "id": "analytics-kpi-AUTOMATION_RATE",
              "type": "single-kpi",
              "title": "Automation Rate (Touchless PO)",
              "width": 4,
              "height": 3,
              "layout": {
                "h": 3,
                "w": 4,
                "x": 4,
                "y": 1,
                "width": 4,
                "height": 3
              },
              "formula": {
                "name": "Automation Rate (Touchless PO)",
                "text": "COUNT(CASE WHEN PU_COUNT(P2P_CASES, P2P_EVENT_LOG.ACTIVITY, P2P_EVENT_LOG.USER_NAME = 'SYSTEM') = PU_COUNT(P2P_CASES, P2P_EVENT_LOG.ACTIVITY) THEN P2P_CASES.CASE_ID END) / COUNT(P2P_CASES.CASE_ID) * 100.0"
              },
              "version": 1,
              "position": {
                "h": 3,
                "w": 4,
                "x": 4,
                "y": 1,
                "width": 4,
                "height": 3
              }
            },
            {
              "h": 3,
              "w": 4,
              "x": 8,
              "y": 1,
              "id": "analytics-kpi-TOTAL_PO_VALUE",
              "type": "single-kpi",
              "title": "Total PO Spend",
              "width": 4,
              "height": 3,
              "layout": {
                "h": 3,
                "w": 4,
                "x": 8,
                "y": 1,
                "width": 4,
                "height": 3
              },
              "formula": {
                "name": "Total PO Spend",
                "text": "SUM(P2P_CASES.PO_AMOUNT)"
              },
              "version": 1,
              "position": {
                "h": 3,
                "w": 4,
                "x": 8,
                "y": 1,
                "width": 4,
                "height": 3
              }
            },
            {
              "h": 3,
              "w": 4,
              "x": 0,
              "y": 4,
              "id": "analytics-kpi-CASE_COUNT",
              "type": "single-kpi",
              "title": "Number of PO Cases",
              "width": 4,
              "height": 3,
              "layout": {
                "h": 3,
                "w": 4,
                "x": 0,
                "y": 4,
                "width": 4,
                "height": 3
              },
              "formula": {
                "name": "Number of PO Cases",
                "text": "COUNT(P2P_CASES.CASE_ID)"
              },
              "version": 1,
              "position": {
                "h": 3,
                "w": 4,
                "x": 0,
                "y": 4,
                "width": 4,
                "height": 3
              }
            },
            {
              "h": 3,
              "w": 4,
              "x": 4,
              "y": 4,
              "id": "analytics-kpi-MAVERICK_BUYING_RATE",
              "type": "single-kpi",
              "title": "Maverick Buying Rate",
              "width": 4,
              "height": 3,
              "layout": {
                "h": 3,
                "w": 4,
                "x": 4,
                "y": 4,
                "width": 4,
                "height": 3
              },
              "formula": {
                "name": "Maverick Buying Rate",
                "text": "COUNT(CASE WHEN PROCESS OCCURRENCE 'Receive Invoice' BEFORE 'Create Purchase Order Item' THEN P2P_CASES.CASE_ID END) / COUNT(P2P_CASES.CASE_ID) * 100.0"
              },
              "version": 1,
              "position": {
                "h": 3,
                "w": 4,
                "x": 4,
                "y": 4,
                "width": 4,
                "height": 3
              }
            },
            {
              "h": 3,
              "w": 4,
              "x": 8,
              "y": 4,
              "id": "analytics-kpi-THREE_WAY_MATCH_RATE",
              "type": "single-kpi",
              "title": "3-Way Match Rate",
              "width": 4,
              "height": 3,
              "layout": {
                "h": 3,
                "w": 4,
                "x": 8,
                "y": 4,
                "width": 4,
                "height": 3
              },
              "formula": {
                "name": "3-Way Match Rate",
                "text": "COUNT(CASE WHEN PROCESS OCCURRENCE['Create Purchase Order Item'] AND PROCESS OCCURRENCE['Receive Goods'] AND PROCESS OCCURRENCE['Receive Invoice'] THEN P2P_CASES.CASE_ID END) / COUNT(P2P_CASES.CASE_ID) * 100.0"
              },
              "version": 1,
              "position": {
                "h": 3,
                "w": 4,
                "x": 8,
                "y": 4,
                "width": 4,
                "height": 3
              }
            },
