        {
          "id": "analytics-kpi-automation_rate",
          "type": "single-kpi",
          "title": "Automation Rate",
          "formula": {
            "name": "Automation Rate",
            "text": "COUNT_TABLE(P2P_CASES) FILTER (NOT FILTER_ACTIVITY('Change Purchase Order') AND NOT FILTER_ACTIVITY('Change Purchase Order Item')) / COUNT_TABLE(P2P_CASES)"
