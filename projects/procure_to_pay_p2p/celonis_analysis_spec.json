          }
        },
        {
          "id": "analytics-kpi-cycle_time_po_to_gr",
          "type": "single-kpi",
          "title": "Cycle Time: PO to GR",
          "formula": {
            "name": "Cycle Time: PO to GR",
            "text": "AVG(CALC_THROUGHPUT(FIRST_OCCURRENCE['Create Purchase Order Item'] TO FIRST_OCCURRENCE['Record Goods Receipt'], REMAP_TIMESTAMPS(\"P2P_EVENT_LOG\".\"EVENT_TIME\", DAYS)))"
          },
          "version": 1,
          "x": 0,
          "y": 1,
          "w": 4,
          "h": 3,
          "width": 4,
          "height": 3,
          "layout": {
            "x": 0,
            "y": 1,
            "w": 4,
            "h": 3,
            "width": 4,
            "height": 3
          },
          "position": {
            "x": 0,
            "y": 1,
            "w": 4,
            "h": 3,
            "width": 4,
            "height": 3
          }
        },
        {
          "id": "analytics-kpi-invoice_processing_time",
          "type": "single-kpi",
          "title": "Invoice Processing Time",
          "formula": {
            "name": "Invoice Processing Time",
            "text": "AVG(CALC_THROUGHPUT(FIRST_OCCURRENCE['Record Goods Receipt'] TO FIRST_OCCURRENCE['First Invoice Created'], REMAP_TIMESTAMPS(\"P2P_EVENT_LOG\".\"EVENT_TIME\", DAYS)))"
