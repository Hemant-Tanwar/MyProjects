      "components": [
        {
          "id": "analytics-filter-REWORK_CASES",
          "type": "dropdown",
          "title": "Rework Cases",
          "filter": {
            "name": "Rework Cases",
            "text": "FILTER PU_COUNT(P2P_CASES, P2P_EVENT_LOG.ACTIVITY) > PU_COUNT_DISTINCT(P2P_CASES, P2P_EVENT_LOG.ACTIVITY);"
          },
          "x": 0,
