        {
          "id": "analytics-kpi-THROUGHPUT_TIME_PO_TO_GR",
          "type": "single-kpi",
          "title": "PO Item to Goods Receipt Throughput Time",
          "formula": {
            "name": "PO Item to Goods Receipt Throughput Time",
            "text": "AVG(CALC_THROUGHPUT(FIRST_OCCURRENCE['Create Purchase Order Item'] TO LAST_OCCURRENCE['Receive Goods'], EVENTTIME('_cel_event_log')))"
          },
          "version": 1,
          "x": 0,
          "y": 1,
          "w": 4,
          "h": 3,
          "width": 4,
          "height": 3,
          "layout": {
            "x": 0,
            "y": 1,
            "w": 4,
            "h": 3,
            "width": 4,
            "height": 3
          },
          "position": {
            "x": 0,
            "y": 1,
            "w": 4,
            "h": 3,
            "width": 4,
            "height": 3
          }
        },
        {
          "id": "analytics-kpi-AUTOMATION_RATE",
          "type": "single-kpi",
          "title": "Automation Rate (Touchless PO)",
          "formula": {
            "name": "Automation Rate (Touchless PO)",
            "text": "COUNT(CASE WHEN PU_COUNT(TEMP_P2P_CASES, TEMP_P2P_EVENT_LOG.ACTIVITY, TEMP_P2P_EVENT_LOG.USER_NAME = 'SYSTEM') = PU_COUNT(TEMP_P2P_CASES, TEMP_P2P_EVENT_LOG.ACTIVITY) THEN TEMP_P2P_CASES.CASE_KEY END) / COUNT(TEMP_P2P_CASES.CASE_KEY) * 100.0"
          },
          "version": 1,
          "x": 4,
          "y": 1,
          "w": 4,
          "h": 3,
          "width": 4,
          "height": 3,
          "layout": {
            "x": 4,
            "y": 1,
            "w": 4,
            "h": 3,
            "width": 4,
            "height": 3
          },
          "position": {
            "x": 4,
            "y": 1,
            "w": 4,
            "h": 3,
            "width": 4,
            "height": 3
          }
        },
        {
          "id": "analytics-kpi-TOTAL_PO_VALUE",
          "type": "single-kpi",
          "title": "Total Purchase Order Net Value",
          "formula": {
            "name": "Total Purchase Order Net Value",
            "text": "SUM(TEMP_P2P_CASES.PO_AMOUNT)"
